{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vanellyetm-ux/Ash/blob/main/schemas/knowledge-record.schema.json",
  "title": "VaN Knowledge HQ Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "title",
    "classification",
    "origin",
    "evidence",
    "promotion_state"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "steward": { "type": "string" },
    "classification": {
      "enum": ["OBSERVATION", "INTERPRETATION", "PROPOSAL", "QUESTION"]
    },
    "domain": { "type": "string" },
    "summary": { "type": "string" },
    "original_text": { "type": "string" },
    "interpretation": { "type": "string" },
    "proposal": { "type": "string" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_system", "source_reference"],
      "properties": {
        "source_system": { "type": "string", "minLength": 1 },
        "source_reference": { "type": "string", "minLength": 1 },
        "source_commit": { "type": ["string", "null"] },
        "source_path": { "type": ["string", "null"] },
        "source_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "captured_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references", "confidence", "limitations"],
      "properties": {
        "references": { "type": "array", "items": { "type": "string" } },
        "validation_method": { "type": ["string", "null"] },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH", "UNASSESSED"] },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authorization": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["authorization_id", "approved_scope", "approved"],
      "properties": {
        "authorization_id": { "type": "string", "minLength": 1 },
        "approved_scope": { "type": "array", "items": { "type": "string" } },
        "approved": { "type": "boolean" },
        "reviewer": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "promotion_state": {
      "enum": [
        "DRAFT",
        "SOURCE_VERIFIED",
        "EVIDENCE_REVIEWED",
        "IMPLEMENTATION_VERIFIED",
        "PROMOTION_APPROVED",
        "PUBLISHED"
      ]
    },
    "supersedes": { "type": ["string", "null"] },
    "transfer_receipt": { "type": ["string", "null"] }
  }
}